#include <windows.h>

#define IDI_UWD 101

IDI_UWD ICON "uwd.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "ayanami770\0"
            VALUE "FileDescription", "Universal Watermark Disabler\0"
            VALUE "FileVersion", "2.0.0-dev\0"
            VALUE "InternalName", "uwd\0"
            VALUE "LegalCopyright", "MIT; Universal-TUI is Apache-2.0\0"
            VALUE "OriginalFilename", "uwd.exe\0"
            VALUE "ProductName", "Universal Watermark Disabler\0"
            VALUE "ProductVersion", "2.0.0-dev\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
